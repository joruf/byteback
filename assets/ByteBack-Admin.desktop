[Desktop Entry]
Version=1.0
Type=Application
Name=ByteBack (Admin)
GenericName=Data Recovery
Comment=Scan raw disks and unallocated space for recoverable files
# %k is this .desktop file. run.py lives in the project root, one directory up.
Exec=/bin/bash -c "cd \\$(dirname \\$(readlink -f \\$0))/.. && exec pkexec python3 ./run.py" %k
Icon=byteback
Terminal=false
Categories=System;Utility;Filesystem;
Keywords=recovery;data;disk;partition;restore;carve;admin;
StartupNotify=true
MimeType=
