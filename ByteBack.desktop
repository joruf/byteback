[Desktop Entry]
Version=1.0
Type=Application
Name=ByteBack
GenericName=Data Recovery
Comment=Scan disks and partitions for recoverable files (requests admin access at startup)
# %k is the path of this file, so the program beside it is the one that starts -- wherever the
# folder was copied to. The same path repairs Icon= in place: a .desktop file cannot point at its
# icon with a relative path (the spec reads one as a theme name), so the launcher writes the
# absolute path of the icon next to it whenever the folder has moved.
Exec=/bin/bash -c "s=\\$(readlink -f \\"\\$0\\"); d=\\${s%%/*}; i=\\$d/assets/icons/byteback.svg; grep -qxF \\"Icon=\\$i\\" \\"\\$s\\" || { I=\\$i awk '/^Icon=/{print \\"Icon=\\" ENVIRON[\\"I\\"]; next}1' \\"\\$s\\" > \\"\\$s.new\\" && mv -f \\"\\$s.new\\" \\"\\$s\\"; }; cd \\"\\$d\\" && exec python3 ./run.py" %k
Icon=/home/joruf/Applications/byteback/assets/icons/byteback.svg
Terminal=false
Categories=System;Utility;Filesystem;
Keywords=recovery;data;disk;partition;restore;carve;
StartupNotify=true
